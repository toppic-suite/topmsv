{
  // Second compile pass for the TopMSV viewer's variants of the five files
  // that diverge from the spectra-browser versions (floating tooltips vs
  // panel-header annotations, no base-intensity lines). The viewer variants
  // live in src/common/toppic_view/, the spectra-browser versions in
  // src/common/topfd_view/; each tsconfig excludes the other's folder, so
  // each pass sees exactly one definition of every global class name and
  // shared files re-emit byte-identical output.
  "compilerOptions": {
    "allowJs": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "target": "es2018",
    "moduleResolution": "node",
    "lib": ["es6", "dom", "es2016"],
    "skipLibCheck": true,
    "rootDir": "./src/common",
    "outDir": "./public/common/js/common",
    "declaration": true,
    "declarationDir": "./types/lib"
  },
  "include": ["./src/common/*/*"],
  "exclude": [
    // spectra-browser variants (this pass compiles the TopMSV viewer
    // variants from src/common/toppic_view instead)
    "./src/common/topfd_view"
  ]
}
