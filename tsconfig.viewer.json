{
  // Second compile pass for the TopMSV viewer's variants of the five files
  // that diverge from the spectra-browser versions (floating tooltips vs
  // panel-header annotations, no base-intensity lines). The variants live in
  // src/common/<module>/viewer/ - one directory deeper than the root
  // tsconfig's "./src/common/*/*" include, so the main pass never sees them.
  // This pass compiles the whole library again with the five spectra files
  // swapped out, so the same global class names never collide within one
  // program; shared files re-emit byte-identical output.
  "compilerOptions": {
    "allowJs": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "target": "es2018",
    "moduleResolution": "node",
    "lib": ["es6", "dom", "es2016"],
    "skipLibCheck": true,
    "rootDir": "./src/common",
    "outDir": "./public/js/common"
  },
  "include": ["./src/common/*/*", "./src/common/*/viewer/*"],
  "exclude": [
    "./src/common/spectrum_view/draw_spectrum.ts",
    "./src/common/spectrum_view/spectrum_view.ts",
    "./src/common/spectrum_view/spectrum_parameter.ts",
    "./src/common/prsm_view/add_shift.ts",
    "./src/common/prsm_view/prsm_para.ts"
  ]
}
