{
  "name": "topmsv-for-toppic",
  "version": "1.0.0",
  "description": "Web tool for visualizing TopFD spectral deconvolution and TopPIC database search results",
  "main": "server.ts",
  "scripts": {
    "start": "ts-node --project tsconfig.server.json server.ts",
    "serve": "ts-node --project tsconfig.server.json server.ts",
    "typecheck:server": "tsc --project tsconfig.server.json",
    "build:client": "npm run clean:client && tsc && tsc --project tsconfig.spectra.json && tsc --project tsconfig.viewerpages.json && tsc --project tsconfig.home.json",
    "convert": "ts-node --project tsconfig.server.json src/server/convert/cli.ts",
    "clean:client": "node -e \"for (const d of ['types/lib','public/common/js','public/topmsv/visual/js','public/topmsv/inspect/js']) require('fs').rmSync(d,{recursive:true,force:true})\""
  },
  "keywords": [
    "mass-spectrometry",
    "proteomics",
    "top-down",
    "toppic",
    "topfd",
    "viewer"
  ],
  "author": "Xiaowen Liu and Claude Code",
  "license": "Apache 2.0",
  "devDependencies": {
    "@types/bootstrap": "^5.2.11",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/jqueryui": "^1.12.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.10.1",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^5.15.4",
    "bootstrap": "^5.3.8",
    "canvas-toBlob": "1.0.0",
    "d3": "^7.9.0",
    "datatables.net": "^1.13.11",
    "datatables.net-dt": "^1.13.11",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.11.0",
    "file-saver": "^2.0.5",
    "jquery": "^3.7.1",
    "jquery-ui": "^1.14.2",
    "multer": "^2.1.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "@fortawesome/fontawesome-free@5.15.4": true
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
