{
  // Shared visualization library (src/common -> public/common/js/common),
  // one program for both apps; also emits the .d.ts files the page-script
  // passes typecheck against.
  "compilerOptions": {
    "allowJs": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "target": "es2018",
    "moduleResolution": "node",
    "lib": ["es6", "dom", "es2016"],
    "skipLibCheck": true,
    "outDir": "./public/common/js/common",
    "declaration": true,
    "declarationDir": "./types/lib"
  },
  "include": ["./src/common/*/*"]
}
