{
  "compilerOptions": {
    "allowJs": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "target": "es2018",
    "moduleResolution": "node",
    "lib": ["es6", "dom", "es2016"],
    "skipLibCheck": true,
    "outDir": "./public/js/common",
    "declaration": true,
    "declarationDir": "./types/spectra-lib"
  },
  "include": ["./src/common/*/*"],
  "exclude": [
    // TopMSV-viewer-only variants (compiled by tsconfig.viewer.json); their
    // class names collide with the spectra-browser versions in topfd_view/.
    "./src/common/toppic_view"
  ]
}
